# IntelliJ Run Configuration
# Active profiles: local
# Working directory: rule-service 저장소 루트
#
# 이 파일을 .env.local로 복사한 뒤 로컬 구성에 맞게 변경합니다.

SERVER_PORT=8081

# Rule이 현재 기준 룰을 조회하는 Learning Service 주소
CORE_BASE_URL=http://localhost:8084
# Learning의 Rule 전용 조회 API와 같은 Credential 설정 필요
RULE_LEARNING_USERNAME=rule-service
RULE_LEARNING_PASSWORD=local-only-change-this-rule-password

# Discovery Service를 함께 실행할 때만 true로 변경
EUREKA_ENABLED=false
EUREKA_URL=http://localhost:8761/eureka/

# Identity Access JWT 검증용 공개 계약
JWT_ISSUER=https://identity.omagotchi.local
JWT_AUDIENCE=omagotchi-api
JWT_PUBLIC_KEY_LOCATION=file:../identity-service/secrets/jwt-public.pem

# MQTT 센서 Broker. 인증 없는 로컬 Broker는 username/password를 비워 둡니다.
SENSOR_BROKER_URL=tcp://localhost:1883
SENSOR_CLIENT_ID=rule-service
SENSOR_USERNAME=
SENSOR_PASSWORD=

# RabbitMQ 로컬 접속 정보
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# InfluxDB 실제 Token은 Git에서 제외된 .env.local에만 입력합니다.
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=local-only-set-influx-token
INFLUXDB_ORG_ID=local-org-id

ENGINE_ID=engine-a
ENGINE_PRIORITY=1

# 로컬 테스트용으로 일단 dummy 넣어놓았습니다.
INTERNAL_SHARED_SECRET=dummy

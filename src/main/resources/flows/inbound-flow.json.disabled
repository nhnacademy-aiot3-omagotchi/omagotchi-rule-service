{
  "id": "inbound-flow",
  "name": "인바운드 파이프라인",
  "description": "MQTT 수신(ChirpStack 직결) -> 정규화 -> 수집 (C-2/C-4 실센서 관찰용)",
  "nodes": [
    {
      "id": "mqtt-sub",
      "type": "MqttSubscriber",
      "config": {
        "topicFilter": "application/+/device/+/event/up"
      }
    },
    {
      "id": "normalizer",
      "type": "Normalizer",
      "config": {}
    },
    {
      "id": "collector",
      "type": "Collector",
      "config": {}
    }
  ],
  "connections": [
    {
      "from": "mqtt-sub:out",
      "to": "normalizer:in"
    },
    {
      "from": "normalizer:out",
      "to": "collector:in"
    }
  ]
}